# Copy to .env and fill in. .env is gitignored.

# Server
NODE_ENV=development
PORT=3000
LOG_LEVEL=debug

# Database (matches docker-compose.yml defaults)
DATABASE_URL=postgresql://boba:boba@localhost:5432/boba?schema=public

# Twilio — get these after creating an account at https://www.twilio.com
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=
TWILIO_MESSAGING_SERVICE_SID=

# When true (default in dev), outbound SMS is logged instead of sent.
TWILIO_DRY_RUN=true

# When true, the inbound webhook rejects requests with bad/missing
# X-Twilio-Signature even if creds are stubbed. Flip on in production.
TWILIO_REQUIRE_SIGNATURE=false

# Public base URL that Twilio webhooks will hit (e.g. ngrok URL in dev).
# MUST match exactly the URL configured in the Twilio console — the
# signature is computed over it.
PUBLIC_WEBHOOK_BASE_URL=http://localhost:3000

# AI seeding (optional, disabled by default)
AI_SEEDING_ENABLED=false
ANTHROPIC_API_KEY=
